node_modules/
.env

dist/
.DS_Store
!**/package.json
!**/package-lock.json
!**/vercel.json

*.json

# 대학어디가(adiga.kr) 입시정보 스냅샷 — 앱 기능에 필요하므로 배포에 포함
!backend/data/adiga/univ-list.json
!backend/data/adiga/univ/*.json
!backend/data/adiga/ipgyeol-index.json
!backend/data/adiga/ipgyeol/*.json

# 2027 수시 대학별 지원 시 유의사항(SKYPASS) — 입결 판정 보정에 쓰이므로 배포에 포함
!backend/data/skypass/*.json

# 실시간 경쟁률 — 대학별 대행사 페이지 주소록. 이게 없으면 수집기가 어디를 볼지 모른다.
# (유웨이 주소는 대학마다 다른 암호 토큰이라 규칙으로 만들 수 없다 → 파일로 들고 다녀야 한다)
!backend/scrapers/ratio/sources.json
# 수집한 스냅샷 자체는 커밋하지 않는다 — 접수 기간에 시각마다 쌓여 저장소가 감당 못 한다.
backend/data/ratio/

# 학생 분석 리포트(개인정보) — 커밋 금지
*_분석결과.*
